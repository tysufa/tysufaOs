swap_floating_layout name="spread" {
    floating_panes max_panes=10{
        pane {y "10%"; x "10%"; width "80%"; height "80%";}
    }
    floating_panes max_panes=20{
        pane {y "10%"; x "10%"; width "30%"; height "30%";}
    }
